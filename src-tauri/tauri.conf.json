{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ALICE",
  "version": "0.2.2",
  "identifier": "com.haine.alice",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ALICE",
        "width": 1280,
        "height": 800,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "ALICE - 設定",
        "width": 500,
        "height": 600,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/haine-sarashina/ALICE/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1MDZGQkFGQTc1OUVCNkQKUldSdDYxbW5yL3NHdFkyRmNQMWRnZkYwY3NEcENQYlpwVWVaYUhpMDJiK00xR21Ybk1iWG9hbDIK"
    }
  }
}
